  "naming": {
    "rules": [
      {
        "element": "module",
        "style": "snake_case",
        "description": "Module names describe a responsibility and use singular or domain-specific nouns.",
        "examples": [
          "project",
          "validation",
          "persistence"
        ]
      },
      {
        "element": "struct",
        "style": "PascalCase",
        "description": "Struct names are nouns representing domain concepts.",
        "examples": [
          "Project",
          "ProjectId"
        ]
      },
      {
        "element": "function",
        "style": "snake_case",
        "description": "Functions use verbs when they perform an action.",
        "examples": [
          "create_project",
          "load_project"
        ]
      },
      {
        "element": "method",
        "style": "snake_case",
        "description": "Methods use conventional Rust names such as new, from_value, validate, and save.",
        "examples": [
          "new",
          "validate",
          "save"
        ]
      },
      {
        "element": "field",
        "style": "snake_case",
        "description": "Fields use clear nouns and should not repeat the enclosing type unnecessarily.",
        "examples": [
          "id",
          "name",
          "created_at"
        ]
      },
      {
        "element": "constant",
        "style": "SCREAMING_SNAKE_CASE",
        "description": "Constants use uppercase names.",
        "examples": [
          "MAX_NAME_LENGTH"
        ]
      }
    ],
    "identifierPatterns": {
      "module": "snake_case",
      "struct": "PascalCase",
      "enum": "PascalCase",
      "trait": "PascalCase",
      "function": "snake_case",
      "method": "snake_case",
      "field": "snake_case",
      "constant": "SCREAMING_SNAKE_CASE",
      "static": "SCREAMING_SNAKE_CASE",
      "typeAlias": "PascalCase",
      "enumVariant": "PascalCase",
      "genericParameter": "PascalCase"
    }
  },
