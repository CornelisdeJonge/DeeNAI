{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/CornelisdeJonge/DeeNAI/main/schema/development-state.schema.json",
  "title": "Software Development State",
  "type": "object",
  "required": [
    "$schema",
    "projectId",
    "updatedAt",
    "currentMilestoneId",
    "currentGoalId",
    "status",
    "focus",
    "workingBranch",
    "lastCommit",
    "completedSinceLastReview",
    "inProgress",
    "nextActions",
    "discoveredWork",
    "blockers",
    "decisionsNeeded",
    "verification",
    "recentCommits",
    "sessionNotes"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "projectId": {
      "$ref": "#/$defs/id"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "currentMilestoneId": {
      "$ref": "#/$defs/id"
    },
    "currentGoalId": {
      "$ref": "#/$defs/id"
    },
    "status": {
      "enum": [
        "not_started",
        "in_progress",
        "blocked",
        "ready_for_review",
        "completed",
        "paused"
      ]
    },
    "focus": {
      "type": "string",
      "minLength": 1
    },
    "workingBranch": {
      "type": "string",
      "minLength": 1
    },
    "lastCommit": {
      "$ref": "#/$defs/commit"
    },
    "completedSinceLastReview": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/completion"
      }
    },
    "inProgress": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/workItem"
      }
    },
    "nextActions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "discoveredWork": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/discoveredWork"
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/blocker"
      }
    },
    "decisionsNeeded": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "verification": {
      "$ref": "#/$defs/verification"
    },
    "recentCommits": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/commit"
      }
    },
    "sessionNotes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "commit": {
      "type": "object",
      "required": [
        "hash",
        "message",
        "timestamp"
      ],
      "additionalProperties": false,
      "properties": {
        "hash": {
          "type": "string",
          "minLength": 7
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "author": {
          "type": "string"
        }
      }
    },
    "completion": {
      "type": "object",
      "required": [
        "itemId",
        "summary",
        "completedAt"
      ],
      "additionalProperties": false,
      "properties": {
        "itemId": {
          "$ref": "#/$defs/id"
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "completedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "workItem": {
      "type": "object",
      "required": [
        "stepId",
        "startedAt",
        "notes",
        "filesChanged"
      ],
      "additionalProperties": false,
      "properties": {
        "stepId": {
          "$ref": "#/$defs/id"
        },
        "startedAt": {
          "type": "string",
          "format": "date-time"
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "filesChanged": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "discoveredWork": {
      "type": "object",
      "required": [
        "id",
        "title",
        "description",
        "source",
        "classification",
        "priority",
        "status",
        "reason"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "classification": {
          "enum": [
            "do_now",
            "sub_goal",
            "defer",
            "reject",
            "blocker"
          ]
        },
        "linkedGoalId": {
          "$ref": "#/$defs/id"
        },
        "priority": {
          "type": "integer",
          "minimum": 1
        },
        "status": {
          "enum": [
            "backlog",
            "accepted",
            "in_progress",
            "completed",
            "rejected"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "blocker": {
      "type": "object",
      "required": [
        "id",
        "description",
        "impact",
        "nextAction"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "impact": {
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ]
        },
        "nextAction": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "verification": {
      "type": "object",
      "required": [
        "checks"
      ],
      "additionalProperties": false,
      "properties": {
        "checks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/checkResult"
          }
        }
      }
    },
    "checkResult": {
      "type": "object",
      "required": [
        "name",
        "status",
        "command"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "not_run",
            "passed",
            "failed",
            "skipped"
          ]
        },
        "command": {
          "type": "string",
          "minLength": 1
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "outputSummary": {
          "type": "string"
        }
      }
    }
  }
}
