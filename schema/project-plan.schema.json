{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/CornelisdeJonge/DeeNAI/main/schema/project-plan.schema.json",
  "title": "Software Project Plan",
  "type": "object",
  "required": [
    "$schema",
    "project",
    "vision",
    "principles",
    "successCriteria",
    "constraints",
    "architecture",
    "milestones",
    "goals",
    "backlog",
    "decisions"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "project": {
      "$ref": "#/$defs/project"
    },
    "vision": {
      "type": "string",
      "minLength": 1
    },
    "principles": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "successCriteria": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "architecture": {
      "$ref": "#/$defs/architecture"
    },
    "milestones": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/milestone"
      }
    },
    "goals": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/goal"
      }
    },
    "backlog": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/backlogItem"
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/decision"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "project": {
      "type": "object",
      "required": [
        "id",
        "name",
        "description",
        "status",
        "createdAt",
        "lastReviewedAt"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "draft",
            "active",
            "paused",
            "completed",
            "cancelled"
          ]
        },
        "createdAt": {
          "$ref": "#/$defs/date"
        },
        "lastReviewedAt": {
          "$ref": "#/$defs/date"
        }
      }
    },
    "architecture": {
      "type": "object",
      "required": [
        "components",
        "dependencyRules"
      ],
      "additionalProperties": false,
      "properties": {
        "components": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "dependencyRules": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "milestone": {
      "type": "object",
      "required": [
        "id",
        "title",
        "description",
        "status",
        "priority",
        "goalIds",
        "exitCriteria"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "planned",
            "in_progress",
            "completed",
            "paused",
            "cancelled"
          ]
        },
        "priority": {
          "type": "integer",
          "minimum": 1
        },
        "goalIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "exitCriteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "goal": {
      "type": "object",
      "required": [
        "id",
        "milestoneId",
        "title",
        "description",
        "status",
        "priority",
        "value",
        "acceptanceCriteria",
        "steps",
        "subGoals",
        "risks"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "milestoneId": {
          "$ref": "#/$defs/id"
        },
        "parentGoalId": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "pending",
            "in_progress",
            "blocked",
            "completed",
            "deferred",
            "cancelled"
          ]
        },
        "priority": {
          "type": "integer",
          "minimum": 1
        },
        "value": {
          "type": "string",
          "minLength": 1
        },
        "acceptanceCriteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/step"
          }
        },
        "subGoals": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/goal"
          }
        },
        "risks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/risk"
          }
        }
      }
    },
    "step": {
      "type": "object",
      "required": [
        "id",
        "title",
        "status",
        "estimate",
        "dependsOn"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "pending",
            "in_progress",
            "blocked",
            "completed",
            "deferred",
            "cancelled"
          ]
        },
        "estimate": {
          "enum": [
            "trivial",
            "small",
            "medium",
            "large",
            "unknown"
          ]
        },
        "dependsOn": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          }
        }
      }
    },
    "risk": {
      "type": "object",
      "required": [
        "description",
        "mitigation"
      ],
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1
        },
        "mitigation": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "backlogItem": {
      "type": "object",
      "required": [
        "id",
        "title",
        "description",
        "status",
        "priority",
        "reason"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "candidate",
            "deferred",
            "rejected",
            "promoted",
            "completed"
          ]
        },
        "priority": {
          "type": "integer",
          "minimum": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "decision": {
      "type": "object",
      "required": [
        "id",
        "title",
        "decision",
        "rationale",
        "date",
        "status"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "decision": {
          "type": "string",
          "minLength": 1
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "date": {
          "$ref": "#/$defs/date"
        },
        "status": {
          "enum": [
            "proposed",
            "accepted",
            "superseded",
            "rejected"
          ]
        }
      }
    }
  }
}
