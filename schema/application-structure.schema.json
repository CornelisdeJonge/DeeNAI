{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/CornelisdeJonge/DeeNAI/main/schema/application-structure.schema.json",
  "title": "Software Application Structure",
  "description": "Machine-readable representation of the components, modules, symbols, APIs, and relationships in a software application.",
  "type": "object",
  "required": [
    "$schema",
    "projectId",
    "updatedAt",
    "language",
    "workspace",
    "naming",
    "modules",
    "relationships"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "projectId": {
      "$ref": "#/$defs/id"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "language": {
      "$ref": "#/$defs/language"
    },
    "workspace": {
      "$ref": "#/$defs/workspace"
    },
    "naming": {
      "$ref": "#/$defs/naming"
    },
    "modules": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/module"
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relationship"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "path": {
      "type": "string",
      "minLength": 1
    },
    "identifier": {
      "type": "string",
      "minLength": 1
    },
    "language": {
      "type": "object",
      "required": [
        "name"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "edition": {
          "type": "string",
          "minLength": 1
        },
        "runtime": {
          "type": "string"
        },
        "compiler": {
          "type": "string"
        },
        "packageManager": {
          "type": "string"
        },
        "buildSystem": {
          "type": "string"
        },
        "formatter": {
          "type": "string"
        },
        "linter": {
          "type": "string"
        },
        "testRunner": {
          "type": "string"
        },
        "toolchainFile": {
          "$ref": "#/$defs/path"
        },
        "configFiles": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/path"
          }
        }
      }
    },
    "visibility": {
      "enum": [
        "private",
        "public",
        "protected",
        "internal",
        "package",
        "exported",
        "unknown"
      ]
    },
    "workspace": {
      "type": "object",
      "required": [
        "root",
        "members"
      ],
      "additionalProperties": false,
      "properties": {
        "root": {
          "$ref": "#/$defs/path"
        },
        "members": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/workspaceMember"
          }
        }
      }
    },
    "workspaceMember": {
      "type": "object",
      "required": [
        "name",
        "path",
        "kind"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "$ref": "#/$defs/identifier"
        },
        "path": {
          "$ref": "#/$defs/path"
        },
        "kind": {
          "enum": [
            "application",
            "executable",
            "library",
            "service",
            "plugin",
            "package",
            "module",
            "test",
            "build_tool",
            "other"
          ]
        },
        "purpose": {
          "type": "string"
        },
        "dependsOn": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/identifier"
          }
        }
      }
    },
    "naming": {
      "type": "object",
      "required": [
        "rules",
        "identifierPatterns"
      ],
      "additionalProperties": false,
      "properties": {
        "rules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/namingRule"
          }
        },
        "identifierPatterns": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "namingRule": {
      "type": "object",
      "required": [
        "element",
        "style",
        "description"
      ],
      "additionalProperties": false,
      "properties": {
        "element": {
          "type": "string",
          "minLength": 1
        },
        "style": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "examples": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "exceptions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "module": {
      "type": "object",
      "required": [
        "id",
        "name",
        "path",
        "visibility",
        "summary",
        "symbols",
        "childModules"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "$ref": "#/$defs/identifier"
        },
        "qualifiedPath": {
          "$ref": "#/$defs/path"
        },
        "component": {
          "$ref": "#/$defs/identifier"
        },
        "path": {
          "$ref": "#/$defs/path"
        },
        "visibility": {
          "$ref": "#/$defs/visibility"
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "responsibilities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "symbols": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/symbol"
          }
        },
        "childModules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/module"
          }
        },
        "imports": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "invariants": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "symbol": {
      "type": "object",
      "required": [
        "id",
        "name",
        "kind",
        "visibility",
        "summary",
        "source",
        "members"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "$ref": "#/$defs/identifier"
        },
        "qualifiedPath": {
          "$ref": "#/$defs/path"
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "visibility": {
          "$ref": "#/$defs/visibility"
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "members": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/member"
          }
        },
        "signature": {
          "type": "string"
        },
        "genericParameters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/genericParameter"
          }
        },
        "attributes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "annotations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "baseTypes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "implements": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "extends": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "targetType": {
          "type": "string"
        },
        "receiver": {
          "type": "string"
        },
        "returnType": {
          "type": "string"
        },
        "errorType": {
          "type": "string"
        },
        "async": {
          "type": "boolean"
        },
        "unsafe": {
          "type": "boolean"
        },
        "test": {
          "$ref": "#/$defs/testMetadata"
        },
        "stability": {
          "enum": [
            "experimental",
            "stable",
            "deprecated",
            "internal",
            "unknown"
          ]
        },
        "deprecationReason": {
          "type": "string"
        },
        "invariants": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sideEffects": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "namingNotes": {
          "type": "string"
        }
      }
    },
    "member": {
      "type": "object",
      "required": [
        "id",
        "name",
        "kind",
        "visibility",
        "summary"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "$ref": "#/$defs/identifier"
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "visibility": {
          "$ref": "#/$defs/visibility"
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "signature": {
          "type": "string"
        },
        "default": {
          "type": "string"
        },
        "required": {
          "type": "boolean"
        },
        "mutable": {
          "type": "boolean"
        },
        "receiver": {
          "type": "string"
        },
        "returnType": {
          "type": "string"
        },
        "errorType": {
          "type": "string"
        },
        "async": {
          "type": "boolean"
        },
        "unsafe": {
          "type": "boolean"
        },
        "genericParameters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/genericParameter"
          }
        },
        "parameters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/parameter"
          }
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "invariants": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sideEffects": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "namingNotes": {
          "type": "string"
        }
      }
    },
    "parameter": {
      "type": "object",
      "required": [
        "name",
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "$ref": "#/$defs/identifier"
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string"
        },
        "required": {
          "type": "boolean"
        }
      }
    },
    "genericParameter": {
      "type": "object",
      "required": [
        "name",
        "kind"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "$ref": "#/$defs/identifier"
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "bounds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "default": {
          "type": "string"
        }
      }
    },
    "source": {
      "type": "object",
      "required": [
        "file"
      ],
      "additionalProperties": false,
      "properties": {
        "file": {
          "$ref": "#/$defs/path"
        },
        "lineStart": {
          "type": "integer",
          "minimum": 1
        },
        "lineEnd": {
          "type": "integer",
          "minimum": 1
        },
        "columnStart": {
          "type": "integer",
          "minimum": 1
        },
        "columnEnd": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "testMetadata": {
      "type": "object",
      "required": [
        "testKind",
        "coverage"
      ],
      "additionalProperties": false,
      "properties": {
        "testKind": {
          "type": "string",
          "minLength": 1
        },
        "coverage": {
          "type": "string"
        },
        "command": {
          "type": "string"
        }
      }
    },
    "relationship": {
      "type": "object",
      "required": [
        "from",
        "type",
        "to",
        "description"
      ],
      "additionalProperties": false,
      "properties": {
        "from": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "to": {
          "$ref": "#/$defs/id"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "direction": {
          "enum": [
            "one_way",
            "two_way"
          ]
        }
      }
    }
  }
}
